# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
OPENAQ_API_KEY=your_openaq_api_key_here

# Giá trị cho máy host (chạy tay / test). Trong docker-compose các service dùng hostname nội bộ.
KAFKA_BOOTSTRAP=localhost:29092
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

PG_USER=aq_user
PG_PASSWORD=aq_password
PG_DB=aq
PG_DSN=postgresql://aq_user:aq_password@localhost:5432/aq

POLL_INTERVAL_SEC=600
NYC_BBOX=-74.26,40.49,-73.70,40.92

# Backfill (M6)
BACKFILL_FROM=2023-01-01
BACKFILL_TO=2025-12-31

# Notifier (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Đổi nếu cổng 8080 trên máy đã bị chiếm
KAFKA_UI_PORT=8080
